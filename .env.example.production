APP_NAME=Trident
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=${APP_URL:?}

# Origen del frontend, para CORS.
FRONTEND_URL=${FRONTEND_URL:?}

APP_LOCALE=es
APP_FALLBACK_LOCALE=es

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# Golden rule 3: PostgreSQL es la única fuente de verdad.
# Los tests corren sobre SQLite en memoria (ver phpunit.xml); esto es la app.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=trident
DB_USERNAME=trident
DB_PASSWORD=${DB_PASSWORD:?}

# Redis: locks, throttle y broker de broadcast. NUNCA estado de partida.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=array

# Reverb en red local: ws:// plano contra la IP LAN de esta máquina.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=trident
REVERB_APP_KEY=trident-local
REVERB_APP_SECRET=${REVERB_APP_SECRET:?}
REVERB_HOST=0.0.0.0
REVERB_PORT=8080
REVERB_SCHEME=http

TRIDENT_DEFAULT_RULE_SET=trident.v1
TRIDENT_IDLE_TIMEOUT_MINUTES=180
TRIDENT_TV_IDLE_NOTICE_MINUTES=30
