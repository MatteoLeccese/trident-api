# Trident API — copy this to `.env` and the stack comes up as it is.
#
#     cp .env.example .env && docker compose up -d
#
# One file serves two readers, on purpose. Docker Compose loads it from beside
# `docker-compose.yml`, and Laravel loads it when you run artisan on the host.
# Two templates that had to agree with each other is a thing that stops agreeing.
#
# Every value below is filled in and works. Nothing here needs editing to play a
# game on this machine; the ones worth changing for a real evening are marked.

# ─── Application ──────────────────────────────────────────────────────────────

APP_NAME=Trident
APP_ENV=local
APP_DEBUG=true

# A key for this machine, already generated so the stack starts on the first try.
# It protects nothing here — there is no session and no user — but generate your
# own with `php artisan key:generate` if this ever leaves your network.
APP_KEY=base64:rUGwA+80BIRqikVBWD0morYqDds2yQ6s6Wao+kHmHIo=

APP_URL=http://localhost:8000

# CHANGE FOR A REAL EVENING: the origin CORS allows, which is where the phones
# and the television load the app from. On a LAN that is this machine's address:
#     FRONTEND_URL=http://192.168.1.10:3000
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL is the only source of truth. The suite runs on SQLite in memory
# (see phpunit.xml) and against this engine too; this block is the application.
#
# The host is `postgres` inside the stack and `127.0.0.1` from this machine. The
# compose file passes the container name to the containers, so leave it as it is
# unless you are running artisan outside Docker.

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=trident
DB_USERNAME=trident
DB_PASSWORD=trident

# ─── Redis ────────────────────────────────────────────────────────────────────
# Locks and throttle counters. NEVER game state: the row is authoritative.

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null

CACHE_STORE=redis
SESSION_DRIVER=array

# Nothing is queued: the state broadcast is dispatched inside the write that
# caused it, so a television never waits on a worker and the stack runs no queue
# container.
QUEUE_CONNECTION=sync

# ─── Reverb ───────────────────────────────────────────────────────────────────
# Two pairs of variables that are easy to confuse:
#   REVERB_SERVER_* → where the `reverb:start` process LISTENS.
#   REVERB_HOST/PORT/SCHEME → where Laravel PUBLISHES to. Their own defaults are
#   443/https, which is wrong on a LAN, so they are set here.

BROADCAST_CONNECTION=reverb

REVERB_APP_ID=trident
REVERB_APP_KEY=trident-local
REVERB_APP_SECRET=trident-local-secret

# Nobody writes over the socket. Absent, Reverb assumes 'all'.
REVERB_APP_ACCEPT_CLIENT_EVENTS_FROM=none

# CHANGE FOR A REAL EVENING: bare hosts, no scheme and no port. Globs allowed:
#     REVERB_ALLOWED_ORIGINS=localhost,127.0.0.1,192.168.1.*
REVERB_ALLOWED_ORIGINS=localhost,127.0.0.1

# The server listens on every interface so a television can reach it.
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

# How long a write waits on the socket server before giving up on it. The
# broadcast happens inside the write, so without these a Reverb that drops
# packets rather than refusing connections would stop the game instead of
# stopping the big screen.
REVERB_CONNECT_TIMEOUT=1.0
REVERB_TIMEOUT=2.0

# ─── The game ─────────────────────────────────────────────────────────────────

TRIDENT_DEFAULT_RULE_SET=trident.v1

# Minutes of silence after which a game is abandoned and its television told.
TRIDENT_IDLE_TIMEOUT_MINUTES=180

# Minutes of silence after which the watch screen says the game looks left
# behind. Always lower than the line above, and a test enforces it.
TRIDENT_TV_IDLE_NOTICE_MINUTES=30

# ─── Backups ──────────────────────────────────────────────────────────────────
# The sidecar dumps the game database on this interval and keeps this many. The
# dumps live in their own volume, never inside the data volume: a backup that
# lives inside the thing it is backing up is not a backup.
#
# Six hours and eight copies is two days of history, which is more than a game
# that expires after three is worth. The restore is rehearsed and written down in
# documentation/deployment/backup-and-restore.md.

TRIDENT_BACKUP_EVERY_SECONDS=21600
TRIDENT_BACKUP_KEEP=8

# ─── The seven challenges ─────────────────────────────────────────────────────
# One phrase per tile face. These are the DEFAULTS a table finds already in its
# boxes; the room can rewrite every one of them in the lobby, and rewriting them
# changes no draw. A game that has started keeps the ones it started with.
#
# At most 80 characters each, on one line: they are painted across a television.
# A line that is left blank or deleted is not an override — the phrase this build
# ships with stands. One that does not fit is refused when the container starts,
# rather than in front of a room.
#
# THESE ARE THE ONE THING BETWEEN "IT RUNS" AND "IT IS A PARTY GAME". Write them.

TRIDENT_CHALLENGE_FACE_0=
TRIDENT_CHALLENGE_FACE_1=
TRIDENT_CHALLENGE_FACE_2=
TRIDENT_CHALLENGE_FACE_3=
TRIDENT_CHALLENGE_FACE_4=
TRIDENT_CHALLENGE_FACE_5=
TRIDENT_CHALLENGE_FACE_6=
