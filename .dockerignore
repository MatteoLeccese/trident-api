.git
.github
vendor
node_modules
storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
.env
.env.*
# The template travels with the image: EnvironmentTemplateTest holds it against
# what config/ actually reads, and the suite runs in the image. It carries no
# secret — that is the point of it being the template.
!.env.example
.phpunit.cache
.phpunit.result.cache
# The conventions travel with the image: SpecificationCoverageTest reads
# trident-rules.md and audits it against the tests, and the suite runs in the
# image. Anything else under documentation/ stays out.
documentation/*
!documentation/conventions
