APP_NAME=Trident
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Origen del frontend, para CORS.
FRONTEND_URL=http://localhost:3000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Golden rule 3: PostgreSQL es la única fuente de verdad.
# Los tests corren sobre SQLite en memoria (ver phpunit.xml); esto es la app.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=trident
DB_USERNAME=trident
DB_PASSWORD=trident

# Redis: locks, throttle y broker de broadcast. NUNCA estado de partida.
# Hasta que el compose de la fase 2 lo levante, la caché va a fichero para que
# esto arranque con sólo PHP instalado. Una plantilla que no funciona recién
# clonada es una trampa.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null

CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=array

# ─── Reverb ───────────────────────────────────────────────────────────────────
# OJO con los dos pares de variables, que se confunden con facilidad:
#   REVERB_SERVER_* → dónde ESCUCHA el proceso `php artisan reverb:start`.
#   REVERB_HOST/PORT/SCHEME → a dónde PUBLICA Laravel, y lo que se refleja al
#   navegador. Sus defaults son 443/https: en LAN hay que sobreescribirlos.
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=trident
REVERB_APP_KEY=trident-local
REVERB_APP_SECRET=cambia-esto-en-local

# Nadie escribe por el socket. Si esta clave falta, Reverb asume 'all'.
REVERB_APP_ACCEPT_CLIENT_EVENTS_FROM=none

# Hosts pelados, sin esquema ni puerto. Admite glob: 192.168.1.*
REVERB_ALLOWED_ORIGINS=localhost,127.0.0.1

# El servidor escucha en todas las interfaces para que el televisor lo alcance.
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# El publicador. En LAN, la IP de esta máquina y ws:// plano.
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

TRIDENT_DEFAULT_RULE_SET=sandbox.v1
TRIDENT_DECK_MODE=ordered_pairs_49
TRIDENT_IDLE_TIMEOUT_MINUTES=180
